# Set these as encrypted secrets in Cloudflare Pages → Settings → Variables and Secrets.
# Use the Supabase Project URL and the service_role key from Supabase → Project Settings → API.
# Never add the service_role key to VITE_ variables or commit its real value.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
