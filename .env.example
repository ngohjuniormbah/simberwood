# Add these as encrypted Cloudflare Pages secrets, not to browser-exposed VITE_ variables.
# Supabase Project URL: Dashboard → Project Settings → API.
# Supabase secret API key (sb_secret_...): Dashboard → Project Settings → API Keys.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"
